#!/usr/bin/env python3
"""
ssbx: bring your Claude Code settings from your machine into the sandbox.

Before every session the ssbx script runs this in a throwaway container, with
the sandbox's home directory (the ssbx-home volume) mounted and a tar stream
on stdin. The stream holds the items it picked from your ~/.claude (the `sync`
list in your config) and your ~/.claude.json. We install them:

  - every synced item replaces its counterpart in the sandbox's ~/.claude, so
    the sandbox always has what your machine has right now
  - from ~/.claude.json only a few things are taken: your MCP servers (when
    SSBX_SYNC_MCP is true), the theme, the onboarding flag, and the settings
    of the current project: its MCP servers and allowed tools. The rest of
    the sandbox's own .claude.json (its login, its other projects) stays
  - .credentials.json, when it is in the stream, becomes the sandbox's login
  - the current project is marked as trusted, so Claude does not ask

Environment: HOME, SSBX_PROJECT (the project directory), SSBX_SYNC_MCP.
"""

import fcntl
import json
import os
import shutil
import sys
import tarfile
import tempfile

home = os.environ["HOME"]
project = os.environ.get("SSBX_PROJECT", "")
sync_mcp = os.environ.get("SSBX_SYNC_MCP", "true") == "true"
managed = os.environ.get("SSBX_SYNC", "").split()  # items that are yours to mirror, present or not

claude_dir = os.path.join(home, ".claude")
claude_json = os.path.join(home, ".claude.json")

PROJECT_KEYS = ("allowedTools", "mcpServers", "enabledMcpjsonServers", "disabledMcpjsonServers",
                "hasClaudeMdExternalIncludesApproved")
GLOBAL_KEYS = ("theme", "hasCompletedOnboarding")


def read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def write_json(path, data, mode=0o600):
    tmp = path + ".ssbx-tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def replace(src, dst):
    if os.path.islink(dst) or os.path.isfile(dst):
        os.unlink(dst)
    elif os.path.isdir(dst):
        shutil.rmtree(dst)
    if src is not None:
        os.rename(src, dst)


def main():
    os.makedirs(claude_dir, mode=0o700, exist_ok=True)
    stage = tempfile.mkdtemp(prefix=".ssbx-sync.", dir=claude_dir)  # same file system: renames, not copies
    try:
        with tarfile.open(fileobj=sys.stdin.buffer, mode="r|") as tar:
            tar.extractall(stage, filter="data")
    except tarfile.TarError as e:
        shutil.rmtree(stage, ignore_errors=True)
        sys.exit(f"ssbx: the settings did not arrive in one piece ({e}); nothing was changed")

    # One sync at a time: two sessions starting together must not tear files.
    lock = open(os.path.join(claude_dir, ".ssbx-sync.lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)

    synced = []
    staged_claude = os.path.join(stage, ".claude")
    arrived = set(os.listdir(staged_claude)) if os.path.isdir(staged_claude) else set()
    for name in sorted(arrived):
        replace(os.path.join(staged_claude, name), os.path.join(claude_dir, name))
        if name == ".credentials.json":
            os.chmod(os.path.join(claude_dir, name), 0o600)
            if not sync_mcp:  # the login only, not the MCP servers' own logins
                creds = read_json(os.path.join(claude_dir, name))
                write_json(os.path.join(claude_dir, name), {k: v for k, v in creds.items() if k == "claudeAiOauth"})
            synced.append("login")
        else:
            synced.append(name)
    for name in managed:  # gone on your machine: gone here
        if name not in arrived and os.path.lexists(os.path.join(claude_dir, name)):
            replace(None, os.path.join(claude_dir, name))

    staged_json = os.path.join(stage, ".claude.json")
    if os.path.isfile(staged_json):
        theirs = read_json(staged_json)
        ours = read_json(claude_json)

        for key in GLOBAL_KEYS:
            if key in theirs:
                ours[key] = theirs[key]
        if sync_mcp and "mcpServers" in theirs:
            ours["mcpServers"] = theirs["mcpServers"]
            synced.append(f"{len(theirs['mcpServers'])} MCP server(s)")
        elif not sync_mcp:
            ours.pop("mcpServers", None)  # gone from your config: gone from the sandbox
            for entry in ours.get("projects", {}).values():
                entry.pop("mcpServers", None)

        if project:
            theirs_project = theirs.get("projects", {}).get(project, {})
            ours_project = ours.setdefault("projects", {}).setdefault(project, {})
            for key in PROJECT_KEYS:
                if key in theirs_project and (sync_mcp or key != "mcpServers"):
                    ours_project[key] = theirs_project[key]
            ours_project["hasTrustDialogAccepted"] = True

        write_json(claude_json, ours)

    shutil.rmtree(stage, ignore_errors=True)
    if synced:
        print("ssbx: synced from your machine: " + ", ".join(synced))


if __name__ == "__main__":
    main()
