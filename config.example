# ssbx configuration. Copy this file into the ssbx profile folder of Colima,
# next to the hosts file (`ssbx status` prints the path):
#
#   Linux    ~/.config/colima/ssbx/config
#   macOS    ~/.colima/ssbx/config
#
# and change what you need; every setting has a default, so an empty file is
# fine too. The file is read by bash. Strings go in quotes, lists in
# parentheses.


# A proxy for everything that leaves the sandbox: Anthropic, npm, PyPI, and
# the hosts from your hosts file. http://host:port or http://user:pass@host:port.
# For a proxy running on your own machine write host.docker.internal instead
# of localhost. Empty: no proxy. If HTTPS_PROXY is set in your shell, that is
# the default.
#proxy="http://host.docker.internal:1080"

# The folders of your machine the VM is allowed to see. The sandbox itself
# gets only the project you start ssbx in, which has to be inside one of them,
# and your ~/.claude (mounted on its own if no folder here contains it; then
# ~/.claude.json stays outside, Colima mounts folders, not files). Your home
# directory by default. Changing this needs `ssbx stop`.
#mounts=("$HOME")

# Size of the VM. Changing these needs `ssbx stop`.
#cpus=4
#memory=8    # GiB
#disk=60     # GiB

# How Claude Code inside the sandbox handles permissions: bypassPermissions,
# auto, acceptEdits or default. Empty: the same as on your machine.
#permission_mode="bypassPermissions"

# Extra environment variables for the sandbox, one "NAME=value" per item.
#env=("ANTHROPIC_MODEL=claude-opus-5-5")

# Extra Debian packages for the sandbox image. Applied by `ssbx rebuild`.
#packages=(build-essential golang)

# Extra options for the `docker run` that starts the sandbox.
#docker_options=(--memory 4g)

# The audit log: what the agent did and what was refused, one JSON object per
# line. See `ssbx logs`.
#log_file="$HOME/.local/state/ssbx/audit.jsonl"

# What goes into it: "all" (every tool call and prompt) or "blocked" (only
# refusals and failures; the proxy's blocks are always in).
#log="all"
