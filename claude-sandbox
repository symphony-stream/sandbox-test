#!/usr/bin/env bash
#
# claude-sandbox: run Claude Code inside a Colima VM.
#
# Usage:
#   claude-sandbox            start Claude Code in the current project
#   claude-sandbox shell      open bash in the same container instead
#   claude-sandbox rebuild    rebuild the image (this also updates Claude Code)
#
# The agent only sees the directory you run this from.

set -euo pipefail

# The Dockerfile sits next to this script.
script_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# Optional file with tokens for the agent, one VAR=value per line.
env_file="$HOME/.config/claude-sandbox/env"

# Name of the Colima VM, and of the Docker context Colima creates for it.
profile="claude-sandbox"
context="colima-claude-sandbox"

image="claude-sandbox"


# 1. Check that we are in a project.
#
# Colima shares your home directory with the VM, so the project has to be
# somewhere inside it. The home directory itself is refused: the agent would
# see all of it, ~/.ssh included.

home_dir="$(cd "$HOME" && pwd -P)"
project_dir="$(pwd -P)"

if [ "$project_dir" = "$home_dir" ]; then
  echo "claude-sandbox: run this inside a project, not in your home directory" >&2
  exit 1
fi

case "$project_dir" in
  "$home_dir"/*)
    ;;
  *)
    echo "claude-sandbox: the project must be inside your home directory ($home_dir)" >&2
    exit 1
    ;;
esac


# 2. Start the VM if it is not running yet.
#
# --activate=false leaves your normal Docker context as it is.

if ! colima status "$profile" >/dev/null 2>&1; then
  colima start "$profile" --cpus 4 --memory 8 --disk 60 --activate=false
fi


# 3. Build the image: on the first run, or when asked to.

if [ "${1:-}" = "rebuild" ]; then
  docker --context "$context" build --no-cache \
    --build-arg UID="$(id -u)" \
    --tag "$image" \
    "$script_dir"
  exit 0
fi

if ! docker --context "$context" image inspect "$image" >/dev/null 2>&1; then
  docker --context "$context" build \
    --build-arg UID="$(id -u)" \
    --tag "$image" \
    "$script_dir"
fi


# 4. Run the container.
#
# --cap-drop ALL and no-new-privileges: nobody inside can become root.
# The claude-sandbox-home volume keeps Claude's login and settings between runs.
# The project is mounted at the same path it has on your machine.

run_options=(
  --rm --interactive --tty
  --cap-drop ALL
  --security-opt no-new-privileges
  --volume claude-sandbox-home:/home/agent/.claude
  --volume "$project_dir:$project_dir"
  --workdir "$project_dir"
)

if [ -f "$env_file" ]; then
  run_options+=(--env-file "$env_file")
fi

if [ "${1:-}" = "shell" ]; then
  shift
  exec docker --context "$context" run "${run_options[@]}" "$image" bash "$@"
else
  exec docker --context "$context" run "${run_options[@]}" "$image" claude --dangerously-skip-permissions "$@"
fi
