#!/bin/sh
#
# ssbx: start the proxy with the settings the launcher passes in the environment.
#
#   SSBX_HOSTS      content of your hosts file (read by addon.py)
#   SSBX_LOG_FILE   where addon.py appends the audit log
#   SSBX_UPSTREAM   an upstream proxy for everything that leaves the sandbox,
#                   http://host:port or http://user:pass@host:port (optional)

set -eu

# The audit log is created by mitmdump: readable by you only.
umask 077

set -- mitmdump \
  --set confdir=/opt/ssbx/ca \
  --set flow_detail=0 \
  --set termlog_verbosity=warn \
  --set stream_large_bodies=1m \
  --scripts /opt/ssbx/addon.py "$@"

if [ -n "${SSBX_UPSTREAM:-}" ]; then
  url="$SSBX_UPSTREAM"
  case "$url" in
    *://*@*)
      scheme="${url%%://*}"
      rest="${url#*://}"
      auth="${rest%@*}"
      hostport="${rest##*@}"
      set -- "$@" --mode "upstream:$scheme://$hostport" --upstream-auth "$auth"
      ;;
    *)
      set -- "$@" --mode "upstream:$url"
      ;;
  esac
fi

exec "$@"
