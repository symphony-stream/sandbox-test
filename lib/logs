#!/usr/bin/env python3
"""
ssbx logs: print the audit log one event per line, readable.

Reads JSON lines on stdin (the ssbx script pipes `tail -f` of the log in).
With the argument "blocked" only refusals and failures are shown.

The log itself is at ~/.local/state/ssbx/audit.jsonl (or `log_file` in the
config) if you want it raw, for jq and friends.
"""

import json
import re
import sys

CONTROL = re.compile(r"[\x00-\x1f\x7f-\x9f]")

only_blocked = len(sys.argv) > 1 and sys.argv[1] == "blocked"
BLOCKED = {"blocked", "denied", "tool_failed"}


def brief(value):
    """One line for a tool input: the command, the file, or the keys."""
    if not isinstance(value, dict):
        return str(value)
    for key in ("command", "file_path", "pattern", "url", "prompt", "description", "query"):
        if key in value:
            text = str(value[key]).replace("\n", " ")
            return text if len(text) <= 120 else text[:120] + "…"
    return ", ".join(value.keys())


def line(event):
    ts = str(event.get("ts", ""))[11:19]
    kind = event.get("event", "?")
    source = event.get("source", "?")

    if kind == "blocked":
        what = f"{event.get('method')} {event.get('host')}{event.get('path')}  ({event.get('reason')})"
        kind = "BLOCKED"
    elif kind == "allowed":
        what = f"{event.get('method')} {event.get('host')}{event.get('path')}"
    elif kind == "passthrough":
        what = f"{event.get('host')}:{event.get('port')}"
        if event.get("method"):
            what = f"{event.get('method')} {what}{event.get('path')}"
    elif kind == "denied":
        what = f"{event.get('tool')}: {brief(event.get('input'))}  ({event.get('reason')})"
        kind = "DENIED"
    elif kind == "tool_failed":
        error = str(event.get("error", "")).replace("\n", " ")
        what = f"{event.get('tool')}: {brief(event.get('input'))}  ({error[:160]})"
        kind = "FAILED"
    elif kind in ("tool", "asked"):
        what = f"{event.get('tool')}: {brief(event.get('input'))}"
    elif kind == "prompt":
        what = str(event.get("text", "")).replace("\n", " ")
    elif kind == "session_start":
        what = f"{event.get('how')} in {event.get('cwd')}"
        if event.get("mode"):
            what += f" ({event['mode']})"
    elif kind == "session_end":
        what = str(event.get("reason"))
    elif kind == "dropped":
        what = f"{event.get('count')} events ({event.get('reason')})"
    else:
        what = json.dumps({k: v for k, v in event.items() if k not in ("ts", "event", "source")})

    return f"{ts}  {source:<8} {kind:<13} {what}"


for raw in sys.stdin:
    raw = raw.strip()
    if not raw:
        continue
    try:
        event = json.loads(raw)
    except ValueError:
        print(raw, flush=True)
        continue
    if only_blocked and event.get("event") not in BLOCKED:
        continue
    # Prompts and commands come from the sandbox; keep its escape sequences off your terminal.
    print(CONTROL.sub(lambda m: "\\x%02x" % ord(m.group()), line(event)), flush=True)
