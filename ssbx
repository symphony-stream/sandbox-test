#!/usr/bin/env python3
"""
ssbx: run Claude Code in a Lima VM that can only reach the hosts you allow.

  ssbx [command ...]   start what is needed and run the command in the VM,
                       in the project you are in (default: claude)
  ssbx stop            stop the VM and the proxy
  ssbx logs [blocked]  follow the audit log (blocked: refusals only, with
                       the config snippet that would allow each)

Nothing else: rebuild the VM with `limactl delete ssbx`, see what is
running with `limactl list`. Everything is configured in one file,
~/.lima/_config/ssbx.toml, created from ssbx.example.toml on the first run.
The proxy runs on your machine and holds your tokens; the VM sees only the
proxy and the folders you mount.
"""

import hashlib
import json
import os
import platform
import re
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.parse
from pathlib import Path

if sys.version_info < (3, 11): sys.exit("ssbx needs Python 3.11 or newer (for tomllib)")
import tomllib  # noqa: E402

REPO = Path(__file__).resolve().parent
INSTANCE = "ssbx"
MACOS = platform.system() == "Darwin"
LIMA_HOME = Path(os.environ.get("LIMA_HOME") or Path.home() / ".lima")
CONFIG_FILE = LIMA_HOME / "_config" / "ssbx.toml"
STATE = LIMA_HOME / "_config" / "ssbx"
SHARE, CA_DIR = STATE / "share", STATE / "ca"
TEMPLATE_OUT = LIMA_HOME / "_templates" / "ssbx.yaml"
INSTANCE_DIR = LIMA_HOME / INSTANCE
EXTRA_PATH = ["/opt/homebrew/bin", "/usr/local/bin", str(Path.home() / ".local" / "bin"),
              "/usr/lib", "/usr/libexec", "/usr/lib/qemu", "/usr/libexec/qemu"]  # tools, and virtiofsd
PERMISSION_MODES = ("", "bypassPermissions", "auto", "acceptEdits", "default", "plan")
KNOWN_KEYS = {"mounts", "cpus", "memory", "disk", "permission_mode", "env", "packages", "proxy", "log",
              "log_file", "proxy_port", "hosts"}  # "hosts" is only validated by proxy.py

def die(*message):
    sys.exit(" ".join(["ssbx:", *message]))

def say(*message):
    print("ssbx:", *message, file=sys.stderr, flush=True)

# ------------------------------------------------------------------ config

def parse_proxy(url):
    # (mitmproxy "mode" value, "user:pass" or None) for an upstream proxy URL
    p = urllib.parse.urlsplit(url)
    try: port = p.port
    except ValueError as e: die(f"{CONFIG_FILE}: proxy: {e}")
    if p.scheme not in ("http", "https") or not p.hostname or p.path or p.query:
        die(f"{CONFIG_FILE}: proxy must look like http://host:port or http://user:pass@host:port")
    auth = f"{p.username}:{p.password or ''}" if p.username else None
    return f"upstream:{p.scheme}://{p.hostname}{f':{port}' if port else ''}", auth

def load_config():
    # [hosts] is not parsed here: proxy.py alone understands it, so its
    # errors show up when the proxy starts, not here.
    if not CONFIG_FILE.exists():
        CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(REPO / "ssbx.example.toml", CONFIG_FILE)
        say(f"created {CONFIG_FILE} from the example; edit it to add your hosts and tokens")
    try: os.chmod(CONFIG_FILE, 0o600)
    except OSError: pass
    try: raw = tomllib.load(open(CONFIG_FILE, "rb"))
    except tomllib.TOMLDecodeError as e: die(f"{CONFIG_FILE}: {e}")
    except OSError as e: die(f"cannot read {CONFIG_FILE}: {e}")
    if set(raw) - KNOWN_KEYS: die(f"{CONFIG_FILE}: unknown setting(s) {sorted(set(raw) - KNOWN_KEYS)}; see ssbx.example.toml")

    def want(key, kind, default):
        value = raw.get(key, default)
        if not isinstance(value, kind) or isinstance(value, bool):
            die(f"{CONFIG_FILE}: {key} has the wrong type; see ssbx.example.toml")
        return value

    cfg = {}
    mounts = want("mounts", list, ["~/Work"])
    if not mounts or not all(isinstance(m, str) and m.strip() for m in mounts):
        die(f"{CONFIG_FILE}: mounts must be a non-empty list of folders")
    home, cfg["mounts"] = Path.home().resolve(), []
    for m in mounts:
        path = Path(os.path.expanduser(m)).resolve()
        if not path.is_dir(): die(f"{CONFIG_FILE}: mount {m} is not a directory")
        if path == home or path in home.parents: die(f"{CONFIG_FILE}: mounting {m} would give the sandbox your whole home")
        cfg["mounts"].append(str(path))
    cfg["cpus"], cfg["memory"], cfg["disk"] = want("cpus", int, 4), want("memory", (int, float), 8), want("disk", int, 60)
    if cfg["cpus"] < 1 or cfg["memory"] < 1 or cfg["disk"] < 10: die(f"{CONFIG_FILE}: cpus, memory and disk are too small")
    cfg["permission_mode"] = want("permission_mode", str, "")
    if cfg["permission_mode"] not in PERMISSION_MODES: die(f"{CONFIG_FILE}: bad permission_mode; see ssbx.example.toml")
    env = want("env", dict, {})
    for k, v in env.items():
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k) or not isinstance(v, (str, int, float)): die(f"{CONFIG_FILE}: env.{k} must be a string")
    cfg["env"] = {k: str(v) for k, v in env.items()}
    cfg["packages"] = want("packages", list, [])
    for p in cfg["packages"]:
        if not isinstance(p, str) or not re.fullmatch(r"[a-z0-9][a-z0-9.+-]*", p): die(f"{CONFIG_FILE}: packages must be Debian package names")
    cfg["proxy"] = want("proxy", str, "").strip()
    cfg["proxy_mode"] = cfg["proxy_auth"] = None
    if cfg["proxy"]: cfg["proxy_mode"], cfg["proxy_auth"] = parse_proxy(cfg["proxy"])
    cfg["log"] = want("log", str, "all")
    if cfg["log"] not in ("all", "blocked"): die(f'{CONFIG_FILE}: log must be "all" or "blocked"')
    cfg["log_file"] = str(Path(os.path.expanduser(want("log_file", str, str(STATE / "audit.jsonl")))).resolve())
    cfg["proxy_port"] = want("proxy_port", int, 17080)
    if not 1024 <= cfg["proxy_port"] <= 65535: die(f"{CONFIG_FILE}: proxy_port must be between 1024 and 65535")
    return cfg

# ------------------------------------------------------------------ tools

def find_tool(name):
    for directory in os.environ.get("PATH", "").split(os.pathsep) + EXTRA_PATH:
        candidate = Path(directory) / name
        if candidate.is_file() and os.access(candidate, os.X_OK): return str(candidate)
    return None

def require_tools():
    for name, install in (("limactl", "brew install lima (macOS), or see https://lima-vm.io/docs/installation/"),
                          ("mitmdump", "uv tool install mitmproxy, pipx install mitmproxy, or brew install mitmproxy")):
        if not find_tool(name): die(f"{name} not found. Install: {install}")
    return find_tool("limactl"), find_tool("mitmdump")

def lima_env():
    # the io_uring-free QEMU wrapper first (Linux), then wherever virtiofsd usually lives
    parts = ([str(STATE / "bin")] if not MACOS else []) + os.environ.get("PATH", "").split(os.pathsep) + EXTRA_PATH
    return dict(os.environ, PATH=os.pathsep.join(dict.fromkeys(p for p in parts if p)))

def qemu_wrapper():
    if MACOS: return
    machine = platform.machine()
    name = f"qemu-system-{'aarch64' if machine in ('arm64', 'aarch64') else machine}"
    (STATE / "bin").mkdir(parents=True, exist_ok=True)
    link, target = STATE / "bin" / name, REPO / "lib" / "qemu-no-io-uring"
    if link.is_symlink() and os.readlink(link) == str(target): return
    if link.exists() or link.is_symlink(): link.unlink()
    link.symlink_to(target)

def mount_type():
    if MACOS or find_tool("virtiofsd"): return "virtiofs"
    say("virtiofsd is not installed, using the slower 9p mounts (Arch: pacman -S virtiofsd, Debian: apt install virtiofsd)")
    return "9p"

def limactl(*args, check=True, capture=False):
    return subprocess.run([find_tool("limactl"), *args], env=lima_env(), check=check, text=True, capture_output=capture)

def vm_status():  # Running, Stopped, Broken, or None when there is no VM
    for line in limactl("list", "--json", INSTANCE, capture=True, check=False).stdout.splitlines():
        line = line.strip()
        if not line.startswith("{"): continue
        try: info = json.loads(line)
        except ValueError: continue
        if info.get("name") == INSTANCE: return info.get("status") or "Stopped"
    return None

# ------------------------------------------------------------------ the proxy

def proxy_pid():
    try: pid = int((STATE / "proxy.pid").read_text().strip()); os.kill(pid, 0)
    except (OSError, ValueError): return None
    try:  # is it still our mitmdump, not a reused pid?
        cmdline = subprocess.run(["ps", "-p", str(pid), "-o", "command="], capture_output=True, text=True).stdout
    except OSError:
        cmdline = "mitmdump"
    return pid if "mitmdump" in cmdline else None

def port_open(port):
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=1): return True
    except OSError: return False

def stop_proxy():
    pid = proxy_pid()
    if pid:
        os.kill(pid, signal.SIGTERM)
        for _ in range(50):
            time.sleep(0.1)
            if proxy_pid() is None: break
        else:
            os.kill(pid, signal.SIGKILL)
    (STATE / "proxy.pid").unlink(missing_ok=True)

def start_proxy(cfg, mitmdump):
    # leave it running if ssbx.toml has not changed since (pidfile + a hash of the file)
    digest, stamp = hashlib.sha256(CONFIG_FILE.read_bytes()).hexdigest(), STATE / "proxy.hash"
    if proxy_pid() and port_open(cfg["proxy_port"]) and stamp.exists() and stamp.read_text() == digest: return
    stop_proxy()
    if port_open(cfg["proxy_port"]): die(f"something else listens on 127.0.0.1:{cfg['proxy_port']}; change proxy_port")
    Path(cfg["log_file"]).parent.mkdir(parents=True, exist_ok=True)
    CA_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(CA_DIR, 0o700)
    # <confdir>/config.yaml (JSON is valid YAML), so the upstream password is never on the command line
    options = {"confdir": str(CA_DIR), "listen_host": "127.0.0.1", "listen_port": cfg["proxy_port"],
               "connection_strategy": "lazy", "stream_large_bodies": "1m", "scripts": [str(REPO / "proxy.py")]}
    if cfg["proxy_mode"]: options["mode"] = [cfg["proxy_mode"]]
    if cfg["proxy_auth"]: options["upstream_auth"] = cfg["proxy_auth"]
    config_path = CA_DIR / "config.yaml"
    config_path.write_text(json.dumps(options) + "\n")
    os.chmod(config_path, 0o600)
    env = dict(os.environ, SSBX_CONFIG=str(CONFIG_FILE), SSBX_LOG_FILE=cfg["log_file"])
    process = subprocess.Popen([mitmdump, "-q", "--set", f"confdir={CA_DIR}"], env=env, stdout=open(STATE / "proxy.log", "ab"),
                               stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True, close_fds=True)
    (STATE / "proxy.pid").write_text(str(process.pid))
    for _ in range(100):
        if port_open(cfg["proxy_port"]): break
        if process.poll() is not None:
            tail = (STATE / "proxy.log").read_text(errors="replace").splitlines()[-8:]
            die("the proxy did not start:\n  " + "\n  ".join(tail))
        time.sleep(0.15)
    else:
        die(f"the proxy did not answer on port {cfg['proxy_port']}; see {STATE / 'proxy.log'}")
    stamp.write_text(digest)
    say(f"proxy started on 127.0.0.1:{cfg['proxy_port']}")

# ------------------------------------------------------------------ the VM

def write_share(cfg):  # the read-only folder the VM sees at /ssbx
    SHARE.mkdir(parents=True, exist_ok=True)
    managed = {"env": {"SSBX_LOG": cfg["log"]}}
    if cfg["permission_mode"]: managed["permissions"] = {"defaultMode": cfg["permission_mode"]}
    (SHARE / "managed.json").write_text(json.dumps(managed, indent=2) + "\n")
    proxy_url = f"http://host.lima.internal:{cfg['proxy_port']}"
    (SHARE / "managed-settings.json").write_text(
        (REPO / "managed-settings.json").read_text().replace("{{proxy}}", proxy_url))
    shutil.copyfile(REPO / "audit-hook", SHARE / "audit-hook")
    ca = CA_DIR / "mitmproxy-ca-cert.pem"
    if not ca.is_file() or ca.stat().st_size == 0: die(f"the proxy has no certificate yet ({ca}); see {STATE / 'proxy.log'}")
    shutil.copyfile(ca, SHARE / "ssbx-ca.crt")
    for f in SHARE.iterdir():
        os.chmod(f, 0o644)

def render_template(cfg):  # vm.yaml filled in from ssbx.toml (JSON is valid YAML)
    port = cfg["proxy_port"]
    proxy_url = f"http://host.lima.internal:{port}"
    bundle = "/etc/ssl/certs/ca-certificates.crt"
    env = {"HTTP_PROXY": proxy_url, "HTTPS_PROXY": proxy_url, "http_proxy": proxy_url, "https_proxy": proxy_url,
           "NO_PROXY": "", "SSL_CERT_FILE": bundle, "REQUESTS_CA_BUNDLE": bundle, "NODE_EXTRA_CA_CERTS": bundle,
           "DISABLE_AUTOUPDATER": "1"}
    claude_dir = Path.home() / ".claude"
    claude_dir.mkdir(mode=0o700, exist_ok=True)
    mounts = [{"location": m, "writable": True} for m in cfg["mounts"]]
    if not any(str(claude_dir) == m or str(claude_dir).startswith(m + "/") for m in cfg["mounts"]):
        mounts.append({"location": str(claude_dir), "writable": True})  # always shared, even if not in "mounts"
    mounts.append({"location": str(SHARE), "mountPoint": "/ssbx", "writable": False})
    values = {
        "image": "debian-13", "vm_type": "vz" if MACOS else "qemu", "cpus": cfg["cpus"],
        "memory": f"{cfg['memory']}GiB", "disk": f"{cfg['disk']}GiB", "mount_type": mount_type(),
        "mounts": mounts, "env": env, "home": str(Path.home()), "proxy_port": str(port),
        "packages": " ".join(cfg["packages"]),
        "provision": "\n".join("    " + line if line else ""
                               for line in (REPO / "provision.sh").read_text().splitlines()),
    }
    text = (REPO / "vm.yaml").read_text()
    for key, value in values.items():
        text = text.replace("{{" + key + "}}", value if key in ("provision", "image") else json.dumps(value))
    return text

def ensure_vm(cfg):  # create, update or start the VM so that it matches ssbx.toml
    qemu_wrapper()
    rendered = render_template(cfg)
    TEMPLATE_OUT.parent.mkdir(parents=True, exist_ok=True)
    TEMPLATE_OUT.write_text(rendered)
    applied, status = STATE / "lima.yaml.applied", vm_status()
    if status is None:
        say("creating the VM, this downloads the Debian image the first time")
        limactl("create", "--tty=false", "--name", INSTANCE, str(TEMPLATE_OUT))
        applied.write_text(rendered)
        status = "Stopped"
    elif status == "Broken":
        say("the VM was left in a broken state, stopping it")
        limactl("stop", "-f", INSTANCE, check=False)
        status = "Stopped"
    if not applied.exists() or applied.read_text() != rendered:
        if status == "Running":
            say("settings changed, run ssbx stop")
        else:
            resolved = STATE / "lima.yaml.resolved"  # self-contained: Lima refuses a raw "base:" in an *instance* file
            limactl("template", "copy", "--embed-all", "--tty=false", str(TEMPLATE_OUT), str(resolved))
            shutil.copyfile(resolved, INSTANCE_DIR / "lima.yaml")
            applied.write_text(rendered)
            say("VM settings updated")
    if status != "Running":
        say("starting the VM")
        if limactl("start", "--tty=false", INSTANCE, check=False).returncode != 0: die("the VM did not start; try: ssbx stop, then ssbx again")

def project():  # the git toplevel, or the current directory
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return Path(top.stdout.strip()).resolve() if top.returncode == 0 and top.stdout.strip() else Path.cwd().resolve()

def inside_mounts(path, cfg):
    return any(str(path) == m or str(path).startswith(m + "/") for m in cfg["mounts"])

def run_in_vm(cfg, command, workdir):
    env_args = []
    for key, setting in (("GIT_AUTHOR_NAME", "user.name"), ("GIT_AUTHOR_EMAIL", "user.email"),
                         ("GIT_COMMITTER_NAME", "user.name"), ("GIT_COMMITTER_EMAIL", "user.email")):
        value = subprocess.run(["git", "config", "--get", setting], capture_output=True, text=True).stdout.strip()
        if value: env_args.append(f"{key}={value}")
    env_args += [f"{k}={v}" for k, v in cfg["env"].items()]
    args = ["shell", "--workdir", str(workdir), INSTANCE, "--"] + (["env", *env_args] if env_args else []) + command
    os.execve(find_tool("limactl"), ["limactl", *args], lima_env())

# ------------------------------------------------------------------ commands

def cmd_run(cfg, command):
    _, mitmdump = require_tools()
    STATE.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE, 0o700)
    project_dir = project()
    if not inside_mounts(project_dir, cfg):
        die(f"{project_dir} is not inside any of your mounts ({', '.join(cfg['mounts'])}); add it to mounts in {CONFIG_FILE}")
    start_proxy(cfg, mitmdump)
    write_share(cfg)
    ensure_vm(cfg)
    run_in_vm(cfg, command, project_dir)

def cmd_stop(cfg):
    require_tools()
    if vm_status() not in (None, "Stopped"): limactl("stop", INSTANCE, check=False)
    stop_proxy()
    say("stopped")

# ------------------------------------------------------------------ logs

CONTROL = re.compile(r"[\x00-\x1f\x7f-\x9f]")
BLOCKED_EVENTS = {"blocked", "denied", "tool_failed"}

def brief(value):  # one line for a tool input: the command, the file, or the keys
    if not isinstance(value, dict): return str(value)
    for key in ("command", "file_path", "pattern", "url", "prompt", "description", "query"):
        if key in value:
            text = str(value[key]).replace("\n", " ")
            return text if len(text) <= 120 else text[:120] + "…"
    return ", ".join(value.keys())

# (text, display kind) for each event kind; falls back to a raw dump below
EVENT_FMT = {
    "blocked": lambda e: (f"{e.get('method')} {e.get('host')}{e.get('path', '')}  ({e.get('reason')})", "BLOCKED"),
    "allowed": lambda e: (f"{e.get('method')} {e.get('host')}{e.get('path', '')}", "allowed"),
    "tunnel": lambda e: (str(e.get("host")), "tunnel"),
    "denied": lambda e: (f"{e.get('tool')}: {brief(e.get('input'))}  ({e.get('reason')})", "DENIED"),
    "tool_failed": lambda e: (f"{e.get('tool')}: {brief(e.get('input'))}  "
                              f"({str(e.get('error', '')).replace(chr(10), ' ')[:160]})", "FAILED"),
    "tool": lambda e: (f"{e.get('tool')}: {brief(e.get('input'))}", "tool"),
    "asked": lambda e: (f"{e.get('tool')}: {brief(e.get('input'))}", "asked"),
    "prompt": lambda e: (str(e.get("text", "")).replace("\n", " "), "prompt"),
    "session_start": lambda e: (f"{e.get('how')} in {e.get('cwd')}" + (f" ({e['mode']})" if e.get("mode") else ""), "session_start"),
    "session_end": lambda e: (str(e.get("reason")), "session_end"),
}

def format_event(event):
    ts, kind, source = str(event.get("ts", ""))[11:19], event.get("event", "?"), event.get("source", "?")
    fmt = EVENT_FMT.get(kind)
    what, kind = fmt(event) if fmt else (json.dumps({k: v for k, v in event.items() if k not in ("ts", "event", "source")}), kind)
    line = f"{ts}  {source:<8} {kind:<13} {what}"
    return CONTROL.sub(lambda m: "\\x%02x" % ord(m.group()), line)  # nothing from the sandbox drives your terminal

def cmd_logs(cfg, only_blocked):
    path = Path(cfg["log_file"])
    if not path.exists(): die(f"no log yet at {path}")
    say(f"{path}" + (" (refusals only)" if only_blocked else "") + ", Ctrl-C to stop")

    def show(raw):
        raw = raw.strip()
        if not raw: return
        try: event = json.loads(raw)
        except ValueError: print(CONTROL.sub("?", raw), flush=True); return
        if only_blocked and event.get("event") not in BLOCKED_EVENTS: return
        print(format_event(event), flush=True)
        if only_blocked and event.get("suggest"):
            snippet = "\n".join("            " + line for line in event["suggest"].splitlines())
            print("          to allow it, add to ssbx.toml:\n" + snippet, flush=True)

    f = open(path, encoding="utf-8", errors="replace")
    try:
        for raw in f:
            show(raw)
        while True:
            raw = f.readline()
            if raw:
                show(raw)
                continue
            time.sleep(0.5)
            if not path.exists() or os.fstat(f.fileno()).st_ino != path.stat().st_ino:
                f.close()  # rotated: start again from the new file
                f = open(path, encoding="utf-8", errors="replace")
    except KeyboardInterrupt: pass
    finally: f.close()

# ------------------------------------------------------------------ main

def main(argv):
    command = argv[1:]
    if command and command[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cfg = load_config()
    if not command: cmd_run(cfg, ["claude"])
    elif command[0] == "--": cmd_run(cfg, command[1:] or ["claude"])
    elif command[0] == "stop": cmd_stop(cfg)
    elif command[0] == "logs": cmd_logs(cfg, len(command) > 1 and command[1] == "blocked")
    else: cmd_run(cfg, command)

if __name__ == "__main__":
    try: main(sys.argv)
    except KeyboardInterrupt: sys.exit(130)
    except subprocess.CalledProcessError as e: die(f"{' '.join(str(a) for a in e.cmd[:2])} failed with exit code {e.returncode}")
